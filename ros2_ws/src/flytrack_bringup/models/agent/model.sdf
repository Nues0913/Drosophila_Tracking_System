<?xml version="1.0"?>
<!-- #88 G0c: flat (emissive-only) materials, no lights, so camera pixels equal the 2D sensor model:
     background/floor 0.15, walls 0.45, target 0.9 (2D evaluation, domain_randomization false).
     The camera output is sRGB-encoded, so each emissive value is the sRGB-decoded intensity
     (0.15 -> 0.0196, 0.45 -> 0.1706, 0.9 -> 0.7874). python/tests/test_gazebo_render_contract.py checks this.
     #88 G0d: every collision shape stays inside the 0.18 m body radius that the collision rule uses
     (agent_radius_m, as in 2D). The wheels used to reach 0.195 m, so the walls stopped the agent at
     4.805 m from the centre on oblique approaches and no collision was recorded.
     wheel_separation is the spacing of the wheels' inner edges (0.26 - 0.035 m): the physics touches the
     floor there, so with the centre spacing the agent turned faster than commanded (the old model by
     0.32 / 0.285 = 1.123, measured 0.561 rad/s for 0.5).
     #140 (E11): with the mass over the wheel axle and only the rear caster, braking tipped the agent
     forward about 35 deg onto its body. The front caster mirrors the rear one but sits 3 mm above the
     floor, so the wheels and the rear caster still carry the agent as before (the G0d turn-rate
     measurement stays valid) and the forward pitch is limited to atan(0.003 / 0.13) = 1.3 deg. -->
<sdf version="1.10">
  <model name="agent">
    <pose>0 0 0.12 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>2</mass><inertia><ixx>0.016</ixx><iyy>0.027</iyy><izz>0.03</izz></inertia></inertial>
      <collision name="body"><pose>0 0 0.05 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry></collision>
      <visual name="body"><pose>0 0 0.05 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
      <sensor name="left_camera" type="camera">
        <pose>0.14 0.06 0.15 0 0 0.7853981633974483</pose><always_on>true</always_on><update_rate>30</update_rate>
        <topic>/model/agent/camera/left/image</topic>
        <camera><horizontal_fov>2.0943951023931953</horizontal_fov>
          <image><width>160</width><height>120</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>20</far></clip></camera>
      </sensor>
      <sensor name="right_camera" type="camera">
        <pose>0.14 -0.06 0.15 0 0 -0.7853981633974483</pose><always_on>true</always_on><update_rate>30</update_rate>
        <topic>/model/agent/camera/right/image</topic>
        <camera><horizontal_fov>2.0943951023931953</horizontal_fov>
          <image><width>160</width><height>120</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>20</far></clip></camera>
      </sensor>
    </link>
    <link name="left_wheel"><pose>0 0.13 -0.04 1.5707963267948966 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.00034</ixx><iyy>0.00034</iyy><izz>0.00064</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
    </link>
    <link name="right_wheel"><pose>0 -0.13 -0.04 1.5707963267948966 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.00034</ixx><iyy>0.00034</iyy><izz>0.00064</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry>
        <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
    </link>
    <link name="caster"><pose>-0.13 0 -0.085 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
      <collision name="ball"><geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="ball"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
    </link>
    <link name="front_caster"><pose>0.13 0 -0.082 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
      <collision name="ball"><geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="ball"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
    <joint name="front_caster_joint" type="ball"><parent>base_link</parent><child>front_caster</child></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.225</wheel_separation><wheel_radius>0.08</wheel_radius>
      <topic>/model/agent/cmd_vel</topic><odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.5</max_linear_velocity><min_linear_velocity>0</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity><min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>1</max_linear_acceleration><min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>3</max_angular_acceleration><min_angular_acceleration>-3</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
