# 本機環境與快取
.env
# No trailing slash: worktrees link .venv as a symlink, which ".venv/" misses.
.venv
.tools/
.cache/
.claude/
.codex/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# 大型原始資料、訓練輸出：不進版本控制
data/*
!data/subgraphs/
data/subgraphs/*
!data/subgraphs/main/
!data/subgraphs/olfactory_v2/
data/subgraphs/olfactory_v2/*
!data/subgraphs/olfactory_v2/graph.npz
!data/subgraphs/olfactory_v2/nodes.parquet
!data/subgraphs/olfactory_v2/edges.parquet
!data/subgraphs/olfactory_v2/manifest.json
!data/subgraphs/olfactory_v2/excluded_odor_seed_sides.csv
!data/subgraphs/olfactory_v2_nokc/
data/subgraphs/olfactory_v2_nokc/*
!data/subgraphs/olfactory_v2_nokc/graph.npz
!data/subgraphs/olfactory_v2_nokc/nodes.parquet
!data/subgraphs/olfactory_v2_nokc/edges.parquet
!data/subgraphs/olfactory_v2_nokc/manifest.json
!data/subgraphs/olfactory_v2_nokc/excluded_odor_seed_sides.csv
runs/
artifacts/*
!artifacts/frontend/
!artifacts/data_execution/
artifacts/data_execution/*
!artifacts/data_execution/*.json

# ROS
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
*.bag
*.db3
*.mcap
colab_workspace/

# 個人文件（計劃書封面含個資；作業 PDF 與本專案無關）
*.pdf
