cff-version: 1.2.0
message: "If you use FlyTrack, please cite it as below, together with the MaleCNS connectome and flyvis."
title: "FlyTrack: Connectome-Constrained Multisensory Target Tracking"
type: software
authors:
  - alias: Nues0913
    website: "https://github.com/Nues0913"
  - alias: MiLong9487
    website: "https://github.com/MiLong9487"
