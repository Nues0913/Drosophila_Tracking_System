<?xml version="1.0"?>
<!-- #88 G0c: flat (emissive-only) materials, no lights, so camera pixels equal the 2D sensor model:
     background/floor 0.15, walls 0.45, target 0.9 (2D evaluation, domain_randomization false).
     The camera output is sRGB-encoded, so each emissive value is the sRGB-decoded intensity
     (0.15 -> 0.0196, 0.45 -> 0.1706, 0.9 -> 0.7874). python/tests/test_gazebo_render_contract.py checks this. -->
<sdf version="1.10"><world name="tracking">
  <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <gravity>0 0 -9.81</gravity>
  <scene><ambient>0 0 0 1</ambient><background>0.0196 0.0196 0.0196 1</background><shadows>false</shadows><grid>false</grid></scene>
  <model name="floor"><static>true</static><link name="floor">
    <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
    <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
      <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.0196 0.0196 0.0196 1</emissive></material></visual>
  </link></model>
  <model name="north_wall"><static>true</static><pose>0 5.05 0.5 0 0 0</pose><link name="wall">
    <collision name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
    <visual name="wall"><geometry><box><size>10 0.1 1</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.1706 0.1706 0.1706 1</emissive></material></visual></link></model>
  <model name="south_wall"><static>true</static><pose>0 -5.05 0.5 0 0 0</pose><link name="wall">
    <collision name="wall"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
    <visual name="wall"><geometry><box><size>10 0.1 1</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.1706 0.1706 0.1706 1</emissive></material></visual></link></model>
  <model name="east_wall"><static>true</static><pose>5.05 0 0.5 0 0 0</pose><link name="wall">
    <collision name="wall"><geometry><box><size>0.1 10 1</size></box></geometry></collision>
    <visual name="wall"><geometry><box><size>0.1 10 1</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.1706 0.1706 0.1706 1</emissive></material></visual></link></model>
  <model name="west_wall"><static>true</static><pose>-5.05 0 0.5 0 0 0</pose><link name="wall">
    <collision name="wall"><geometry><box><size>0.1 10 1</size></box></geometry></collision>
    <visual name="wall"><geometry><box><size>0.1 10 1</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular><emissive>0.1706 0.1706 0.1706 1</emissive></material></visual></link></model>
  <include><uri>model://agent</uri><name>agent</name></include>
  <include><uri>model://target</uri><name>target</name></include>
</world></sdf>
